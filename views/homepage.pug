doctype html
html
  head
    title= `${title}`
    meta(name="viewport" content="width=device-width, initial-scale=1")
    link(rel="stylesheet", href="/css/style.css")
  body
    h1 Custom Object Table
    a(href="/update-cobj") Add to this table
    table 
        thead
            tr
            th ID
            th Name
            th Genre
            th Rating
        tbody
            each obj in data
                tr
                    td #{obj.id}
                    td #{obj.properties.name}
                    td #{obj.properties.genre}
                    td #{obj.properties.rating}